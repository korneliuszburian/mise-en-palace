        "mcpServers": [],
        "skills": []
      }
    },
    "krn": {
      "profile": {
        "name": "krn-codex-eval",
        "configPath": "evals/codex-capability/profiles/krn-codex-eval.config.toml"
      },
      "capabilities": {
        "mcpServers": [
          {
            "id": "krn_decision_packet",
            "transport": "stdio",
            "readOnly": true
          }
        ],
        "skills": [
          {
            "name": "krn-memory-core",
            "path": ".agents/skills/krn-memory-core/SKILL.md"
          }
