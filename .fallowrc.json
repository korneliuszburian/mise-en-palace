{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/config-schema.json",
  "ignorePatterns": [
    ".local-lab/**",
    "docs/materials/**",
    "tests/fixtures/**",
    "**/*.typecheck.ts"
  ],
  "usedClassMembers": [
    {
      "implements": "EventLedgerRepository",
      "members": [
        "appendRunEvent",
        "listRunEvents"
      ]
    },
    {
      "implements": "HarnessRunRepository",
      "members": [
        "createOperatorIntent",
        "createTaskContract",
        "createHarnessPlan",
        "createReviewAssessment",
        "createFeedbackDelta",
        "updateExecutionRunStatus"
      ]
    },
    {
      "implements": "MemoryRepository",
      "members": [
        "getMemoryRecord",
        "promoteReviewedMemoryCandidate",
        "rejectMemoryCandidate",
        "listMemoryCandidates",
        "createMemoryFeedbackEvent",
        "rejectAntiMemoryCandidate",
        "listAntiMemoryCandidates"
      ]
    },
    {
      "implements": "OutboxRepository",
      "members": [
        "enqueue",
        "listPending"
      ]
    },
    {
      "implements": "RetrievalRepository",
      "members": [
        "completeRetrievalRun",
        "cleanupTestRetrievalRecords"
      ]
    },
    {
      "implements": "SourceRepository",
      "members": [
        "createSourceChunk",
        "getSourceDecisionEdgeById"
      ]
    },
    {
      "implements": "WorkerJobRepository",
      "members": [
        "enqueue",
        "getWorkerJobById"
      ]
    },
    "createGroup",
    "addItems",
    "recordFeedback",
    "getReflectionRecordById",
    "listReflectionRecordsByScope"
  ],
  "audit": {
    "gate": "new-only"
  }
}
