{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/config-schema.json",
  "ignorePatterns": [
    ".local-lab/**",
    "docs/materials/**",
    "tests/fixtures/**",
    "**/*.typecheck.ts"
  ],
  "usedClassMembers": [
    {
      "implements": "HarnessRunRepository",
      "members": [
        "createOperatorIntent",
        "createTaskContract",
        "createHarnessPlan",
        "createReviewAssessment",
        "createFeedbackDelta",
        "getFeedbackDeltaForProject",
        "updateExecutionRunStatus"
      ]
    },
    {
      "implements": "MemoryRepository",
      "members": [
        "getMemoryRecord",
        "promoteReviewedMemoryCandidate",
        "rejectMemoryCandidate",
        "listMemoryCandidates",
        "listMemoryRecordsForProject",
        "listActiveMemory",
        "listHistoricalMemoryWarnings",
        "createMemoryCandidate",
        "invalidateMemoryRecord",
        "supersedeMemoryRecord",
        "recordMemoryApplication",
        "recordMemoryApplicationOnce",
        "createMemoryFeedbackEvent",
        "createAntiMemoryCandidate",
        "getAntiMemoryCandidateById",
        "promoteReviewedAntiMemoryCandidate",
        "rejectAntiMemoryCandidate",
        "listAntiMemoryCandidates"
      ]
    },
    {
      "implements": "OutboxRepository",
      "members": [
        "enqueue",
        "listPending"
      ]
    },
    {
      "implements": "RetrievalRepository",
      "members": [
        "completeRetrievalRun",
        "cleanupTestRetrievalRecords"
      ]
    },
    {
      "implements": "SourceRepository",
      "members": [
        "createSourceChunk",
        "deprecateSourceClaim",
        "createSourceClaimEdge",
        "listSourceClaimEdgesForClaim",
        "createSourceDecisionEdge",
        "listHistoricalClaimWarningsForProject",
        "listSourceDecisionEdgesForRun",
        "createSourceRejection",
        "getSourceDecisionEdgeById"
      ]
    },
    {
      "implements": "WorkerJobRepository",
      "members": [
        "enqueue",
        "getWorkerJobById"
      ]
    },
    "createGroup",
    "addItems",
    "recordFeedback",
    "getReflectionRecordById",
    "listReflectionRecordsByScope"
  ],
  "audit": {
    "gate": "new-only"
  }
}
