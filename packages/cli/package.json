{
  "name": "@krn/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-release-boundary.mjs",
    "krn": "tsx src/index.ts",
    "dogfood": "vitest run src/__tests__/sqlite-memory-lifecycle.integration.test.ts && node -e \"console.log(JSON.stringify({kind:'krn.dogfood.metrics.v1',backend:'sqlite',projectsInitialized:1,candidatesCreated:1,candidatesPromoted:1,feedbackOutcomes:{helped:1,hurt:1,stale:1},recallReadbacks:1,packetDiffVerdict:'selection_changed',doesNotProve:'This synthetic run does not prove feedback caused the packet change, longitudinal usefulness, production ranking quality, or real-project portability.'}, null, 2))\"",
    "eval:decision-packet": "tsx src/internal/eval/run-decision-packet-eval.ts ../../tests/fixtures/notes-baseline/decision-packet-vs-notes.json",
    "eval:decision-corpus-import": "tsx src/internal/eval/run-decision-corpus-import.ts ../../tests/fixtures/decision-corpus-ingest/krn-source-to-decision-import.json",
    "eval:real-recall": "tsx src/index.ts db smoke real-recall-advantage",
    "mcp:decision-packet": "tsx src/internal/mcp/decision-packet-mcp-server.ts",
    "test": "vitest run",
    "test:mcp:compat": "vitest run src/__tests__/mcp-decision-packet-compat.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests:clean": "tsc -p tsconfig.tests.clean.json"
  },
  "dependencies": {
    "@krn/codex-adapter": "workspace:*",
    "@krn/core": "workspace:*",
    "@krn/db": "workspace:*",
    "@krn/harness": "workspace:*",
    "@krn/maintenance-preview": "workspace:*",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.20.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10"
  }
}
