{
  "name": "@krn/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "krn": "tsx src/index.ts",
    "eval:brain-ranking": "tsx src/runBrainRankingEval.ts ../../tests/fixtures/brain-ranking/brain-ranking-eval.json",
    "eval:source-graph-ranking": "tsx src/runSourceGraphRankingEval.ts ../../tests/fixtures/source-graph-ranking/source-graph-ranking-eval.json",
    "eval:memory-advantage": "tsx src/runMemoryAdvantageEval.ts ../../tests/fixtures/memory-advantage/company-pattern-memory-advantage.json",
    "eval:codex-output-comparator": "tsx src/runCodexOutputComparatorEval.ts ../../tests/fixtures/memory-advantage/company-pattern-memory-advantage.json",
    "eval:notes-baseline": "tsx src/runNotesBaselineEval.ts ../../tests/fixtures/notes-baseline/decision-packet-vs-notes.json",
    "eval:decision-packet": "tsx src/runDecisionPacketEval.ts ../../tests/fixtures/notes-baseline/decision-packet-vs-notes.json",
    "eval:codex-decision-packet-obedience": "tsx src/runCodexDecisionPacketObedienceEval.ts ../../tests/fixtures/codex-decision-packet-obedience/recorded-obedience.json",
    "eval:second-repo-decision-packet": "tsx src/runSecondRepoDecisionPacketEval.ts ../../tests/fixtures/second-repo/weak-json-decision-packet-vs-notes.json ../../tests/fixtures/second-repo/env-config-decision-packet-vs-notes.json",
    "eval:decision-corpus-import": "tsx src/runDecisionCorpusImport.ts ../../tests/fixtures/decision-corpus-ingest/krn-source-to-decision-import.json",
    "eval:corpus-closure": "tsx src/runCorpusClosureSmoke.ts",
    "eval:determinism": "tsx src/runDeterministicEval.ts ../../tests/fixtures/brain-ranking/brain-ranking-eval.json ../../tests/fixtures/source-graph-ranking/source-graph-ranking-eval.json ../../tests/fixtures/memory-advantage/company-pattern-memory-advantage.json ../../tests/fixtures/notes-baseline/decision-packet-vs-notes.json ../../tests/fixtures/second-repo/weak-json-decision-packet-vs-notes.json ../../tests/fixtures/second-repo/env-config-decision-packet-vs-notes.json ../../tests/fixtures/codex-decision-packet-obedience/recorded-obedience.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests:clean": "tsc -p tsconfig.tests.clean.json"
  },
  "dependencies": {
    "@krn/codex-adapter": "workspace:*",
    "@krn/core": "workspace:*",
    "@krn/db": "workspace:*",
    "@krn/harness": "workspace:*",
    "@krn/workers": "workspace:*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
