{
  "name": "@krn/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-release-boundary.mjs",
    "krn": "tsx src/index.ts",
    "eval:decision-packet": "tsx src/internal/eval/run-decision-packet-eval.ts ../../tests/fixtures/notes-baseline/decision-packet-vs-notes.json",
    "eval:codex-decision-packet-obedience:recorded": "tsx src/internal/eval/run-codex-decision-packet-obedience-eval.ts ../../tests/fixtures/codex-decision-packet-obedience/recorded-obedience.json",
    "eval:codex-decision-packet-obedience:recorded-replay": "tsx src/internal/eval/run-codex-decision-packet-obedience-eval.ts ../../tests/fixtures/codex-decision-packet-obedience/recorded-replay-2026-07-06.json",
    "eval:second-repo-decision-packet": "tsx src/internal/eval/run-second-repo-decision-packet-eval.ts ../../tests/fixtures/second-repo/weak-json-decision-packet-vs-notes.json ../../tests/fixtures/second-repo/env-config-decision-packet-vs-notes.json ../../tests/fixtures/second-repo/async-job-decision-packet-vs-notes.json",
    "eval:decision-corpus-import": "tsx src/internal/eval/run-decision-corpus-import.ts ../../tests/fixtures/decision-corpus-ingest/krn-source-to-decision-import.json",
    "eval:paired-live-codex-repair": "tsx src/internal/eval/run-paired-live-codex-repair.ts",
    "eval:paired-live-codex-repair:persist": "tsx src/internal/eval/persist-paired-live-codex-repair.ts",
    "eval:paired-live-codex-repair:tracked": "tsx src/internal/eval/run-tracked-paired-live-codex-repair.ts",
    "eval:corpus-closure": "tsx src/internal/eval/run-corpus-closure-smoke.ts",
    "eval:real-recall": "tsx src/index.ts db smoke real-recall-advantage",
    "eval:determinism": "tsx src/internal/eval/run-deterministic-eval.ts ../../tests/fixtures/notes-baseline/decision-packet-vs-notes.json ../../tests/fixtures/second-repo/weak-json-decision-packet-vs-notes.json ../../tests/fixtures/second-repo/env-config-decision-packet-vs-notes.json ../../tests/fixtures/second-repo/async-job-decision-packet-vs-notes.json ../../tests/fixtures/codex-decision-packet-obedience/recorded-obedience.json",
    "mcp:decision-packet": "tsx src/internal/mcp/decision-packet-mcp-server.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests:clean": "tsc -p tsconfig.tests.clean.json"
  },
  "dependencies": {
    "@krn/codex-adapter": "workspace:*",
    "@krn/core": "workspace:*",
    "@krn/db": "workspace:*",
    "@krn/harness": "workspace:*",
    "@krn/maintenance-preview": "workspace:*",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
