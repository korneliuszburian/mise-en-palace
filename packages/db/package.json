{
  "name": "@krn/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./adapters": {
      "types": "./src/repositories/index.ts",
      "import": "./src/repositories/index.ts"
    },
    "./dev": {
      "types": "./src/dev/index.ts",
      "import": "./src/dev/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-release-boundary.mjs",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:check:sqlite": "drizzle-kit check --config drizzle.sqlite.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@krn/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@krn/harness": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10"
  }
}
