{
  "name": "mise-en-palace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x",
    "pnpm": "10.32.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@beads/bd"
    ]
  },
  "scripts": {
    "db:check": "pnpm --filter @krn/db db:check",
    "db:generate": "pnpm --filter @krn/db db:generate",
    "db:migrate": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db migrate",
    "db:ready": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db readiness",
    "db:test:clean": "pnpm test && pnpm db:ready",
    "db:smoke": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke",
    "db:smoke:harness-evidence": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke harness-evidence",
    "db:smoke:harness-plan": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke harness-plan",
    "db:smoke:memory-governance": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke memory-governance",
    "db:smoke:eval-feedback-persistence": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke eval-feedback-persistence",
    "db:smoke:retrieval-substrate": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke retrieval-substrate",
    "db:smoke:activation": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke activation",
    "db:smoke:memory-loop": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke memory-loop",
    "db:smoke:memory-search": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke memory-search",
    "db:smoke:run-show": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke run-show",
    "db:smoke:maintenance-boundary": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke maintenance-boundary",
    "db:smoke:codex-adapter": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke codex-adapter",
    "db:smoke:maintenance-queue": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke maintenance-queue",
    "db:smoke:init-connect": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke init-connect",
    "db:smoke:target-repo-harness": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke target-repo-harness",
    "db:smoke:decision-corpus-import": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke decision-corpus-import",
    "db:smoke:real-recall-advantage": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke real-recall-advantage",
    "db:smoke:decision-packet-return-loop": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke decision-packet-return-loop",
    "db:smoke:source-graph": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli krn db smoke source-graph",
    "eval:decision-packet": "pnpm --filter @krn/cli eval:decision-packet",
    "eval:codex-decision-packet-obedience:recorded": "pnpm --filter @krn/cli eval:codex-decision-packet-obedience:recorded",
    "eval:codex-decision-packet-obedience:recorded-replay": "pnpm --filter @krn/cli eval:codex-decision-packet-obedience:recorded-replay",
    "eval:second-repo-decision-packet": "pnpm --filter @krn/cli eval:second-repo-decision-packet",
    "eval:decision-corpus-import": "pnpm --filter @krn/cli eval:decision-corpus-import",
    "eval:corpus-closure": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli eval:corpus-closure",
    "eval:real-recall": "KRN_DATABASE_URL=${KRN_DATABASE_URL:-postgres://krn:krn@localhost:54329/krn} pnpm --filter @krn/cli eval:real-recall",
    "eval:determinism": "pnpm --filter @krn/cli eval:determinism",
    "mcp:decision-packet": "pnpm --silent --filter @krn/cli mcp:decision-packet",
    "eval:required:behavior-gates": "pnpm --filter @krn/harness exec vitest run src/__tests__/krn-behavior-gate.test.ts src/__tests__/typescript-boundary-invariants.test.ts",
    "eval:required:type-boundary": "pnpm --filter @krn/cli typecheck:tests:clean",
    "eval:required:readback-falsifiers": "pnpm --filter @krn/cli exec vitest run src/__tests__/run-run-show-command.test.ts src/__tests__/evidence-capture-behavior.test.ts src/__tests__/run-brain-search-command.test.ts src/__tests__/brain-ranking-eval.test.ts src/__tests__/source-graph-ranking-eval.test.ts src/__tests__/memory-advantage-eval.test.ts src/__tests__/decision-packet-eval.test.ts src/__tests__/codex-decision-packet-obedience-eval.test.ts src/__tests__/second-repo-decision-packet-eval.test.ts src/__tests__/decision-corpus-import.test.ts",
    "eval:required:decision-packet": "pnpm eval:decision-packet",
    "eval:required:codex-obedience-recorded": "pnpm eval:codex-decision-packet-obedience:recorded",
    "eval:required:target-repo-packet": "pnpm eval:second-repo-decision-packet",
    "eval:required:decision-corpus-import": "pnpm eval:decision-corpus-import",
    "eval:required:codex-brief-render": "pnpm --filter @krn/codex-adapter exec vitest run src/__tests__/codex-brief-behavior.test.ts",
    "eval:required": "pnpm eval:required:behavior-gates && pnpm eval:required:type-boundary && pnpm eval:required:readback-falsifiers && pnpm eval:required:decision-packet && pnpm eval:required:codex-obedience-recorded && pnpm eval:required:target-repo-packet && pnpm eval:required:decision-corpus-import && pnpm eval:required:codex-brief-render",
    "eval:db:retrieval-substrate": "pnpm db:smoke:retrieval-substrate",
    "eval:db:decision-packet-return-loop": "pnpm db:smoke:decision-packet-return-loop",
    "eval:db:target-repo-harness": "pnpm db:smoke:target-repo-harness",
    "eval:db": "pnpm eval:db:retrieval-substrate && pnpm eval:db:decision-packet-return-loop && pnpm eval:db:target-repo-harness",
    "eval:lab:determinism": "pnpm eval:determinism",
    "eval:lab:corpus-closure": "pnpm eval:corpus-closure",
    "eval:lab:real-recall": "pnpm eval:real-recall",
    "eval:lab": "pnpm eval:lab:determinism && pnpm eval:lab:corpus-closure && pnpm eval:lab:real-recall",
    "eval:recorded-replay:codex-obedience": "pnpm eval:codex-decision-packet-obedience:recorded-replay",
    "eval:recorded-replay": "pnpm eval:recorded-replay:codex-obedience",
    "krn": "pnpm --filter @krn/cli krn",
    "beads:prime": "bd prime",
    "beads:ready": "bd ready --json",
    "beads:doctor": "bd doctor",
    "beads:validate": "node scripts/validate-beads-history.mjs validate --issues .beads/issues.jsonl --interactions .beads/interactions.jsonl",
    "beads:roundtrip": "node scripts/validate-beads-history.mjs roundtrip --issues .beads/issues.jsonl --interactions .beads/interactions.jsonl",
    "platform:check": "node scripts/check-platform.mjs",
    "release:check": "node scripts/check-release-boundary.mjs",
    "prepublishOnly": "node scripts/check-release-boundary.mjs",
    "fixtures:check": "node scripts/check-fixture-ownership.mjs",
    "toolchain:check": "node scripts/check-toolchain.mjs",
    "node22:type-boundary": "node scripts/check-node22-type-boundary.mjs",
    "security:secrets": "node scripts/security-policy.mjs secrets --tracked",
    "security:licenses": "mkdir -p .local-lab/security && pnpm licenses list --json > .local-lab/security/licenses.json && node scripts/security-policy.mjs licenses --report .local-lab/security/licenses.json",
    "security:dependency-audit": "node scripts/security-policy.mjs dependency-audit",
    "workspace:check": "node scripts/check-workspace-scripts.mjs",
    "check:whitespace:committed": "node scripts/check-committed-whitespace.mjs",
    "quality:fallow": "pnpm quality:fallow:report",
    "quality:fallow:report": "node scripts/run-fallow-report.mjs",
    "quality:fallow:ci": "node scripts/run-fallow-ci.mjs",
    "verify:fast": "pnpm toolchain:check -- --allow-missing-rtk && pnpm node22:type-boundary && pnpm platform:check && pnpm workspace:check && pnpm fixtures:check && pnpm typecheck && pnpm test && pnpm krn doctor && pnpm quality:fallow:ci && pnpm eval:required && pnpm check:whitespace:committed && git diff --check",
    "verify:db": "timeout --signal=TERM --kill-after=10s 120s pnpm db:migrate && pnpm db:ready && pnpm db:test:clean && pnpm --filter @krn/db db:check && pnpm --filter @krn/cli exec vitest run src/__tests__/source-decision-import-retry.test.ts && pnpm db:smoke && pnpm db:smoke:memory-governance && pnpm db:smoke:eval-feedback-persistence && pnpm db:smoke:memory-loop && pnpm db:smoke:memory-search && pnpm db:smoke:run-show && pnpm db:smoke:maintenance-queue && pnpm db:smoke:source-graph && pnpm db:smoke:activation && pnpm db:smoke:decision-corpus-import && pnpm eval:db:retrieval-substrate && pnpm eval:db:decision-packet-return-loop && pnpm eval:db:target-repo-harness",
    "alpha:verify": "pnpm alpha:verify:fast",
    "alpha:verify:fast": "pnpm toolchain:check && pnpm node22:type-boundary && pnpm typecheck && pnpm test && pnpm krn doctor",
    "alpha:verify:full": "pnpm verify:fast && pnpm verify:db",
    "test": "pnpm workspace:check && pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm workspace:check && pnpm -r --workspace-concurrency=1 typecheck"
  },
  "devDependencies": {
    "@beads/bd": "^1.0.4",
    "@types/node": "22.20.1",
    "fallow": "2.103.0",
    "typescript": "5.9.3"
  }
}
