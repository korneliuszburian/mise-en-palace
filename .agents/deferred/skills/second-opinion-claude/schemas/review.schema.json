{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KRN second-opinion review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_version",
    "verdict",
    "risk_class",
    "diff_sha256",
    "summary",
    "findings",
    "evidence_gaps",
    "another_loop_required",
    "non_blocking_notes"
  ],
  "properties": {
    "review_version": {
      "const": "1"
    },
    "verdict": {
      "enum": ["approve", "approve_with_fixes", "block"]
    },
    "risk_class": {
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "evidence_ref", "reason", "minimal_fix"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "minimal_fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "verification_requested"],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "verification_requested": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "another_loop_required": {
      "type": "boolean"
    },
    "non_blocking_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "why_non_blocking"],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1
          },
          "why_non_blocking": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
